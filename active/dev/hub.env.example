HUB_IMAGE=ghcr.io/lucurlings/devctl-hub:latest

# Used only by the optional `telegram` profile.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ID=
# Disable timer-based topic deletion. The persistent agent wrapper handles
# unexpected CLI exits. Set positive values only for automatic topic deletion.
TELEGRAM_AUTOCLOSE_DONE_MINUTES=0
TELEGRAM_AUTOCLOSE_DEAD_MINUTES=0
