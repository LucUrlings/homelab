HUB_IMAGE=ghcr.io/lucurlings/devctl-hub:latest

# Used only by the optional `telegram` profile.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_GROUP_ID=
# Keep ended topics until they are removed manually. Set positive values only
# when CCGram should delete completed or dead topics automatically.
TELEGRAM_AUTOCLOSE_DONE_MINUTES=0
TELEGRAM_AUTOCLOSE_DEAD_MINUTES=0
